# ── Banco ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://estoque:estoque@db:5432/estoque_db
DATABASE_USER=estoque
DATABASE_PASSWORD=estoque
DATABASE_NAME=estoque_db
DATABASE_HOST=db
DATABASE_PORT=5432

POSTGRES_USER=estoque
POSTGRES_PASSWORD=estoque
POSTGRES_DB=estoque_db

# ── API ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# Em produção, gere com: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
# 8 horas — cobre uma jornada de campo inteira sem reautenticar
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# Fuso de quem lê a planilha. O contêiner roda em UTC; é isto que faz a coluna
# "Data da visita" bater com o relógio de quem fez a contagem.
TIMEZONE=America/Sao_Paulo

# Nome do fornecedor no cabeçalho do pedido em PDF que o vendedor entrega ao
# comprador da loja. Em branco, a linha não sai — o PDF continua saindo.
COMPANY_NAME=

FRONTEND_URL=http://localhost:5174

# ── Frontend ───────────────────────────────────────────────────────────
# Endereço da API visto pelo NAVEGADOR, congelado no bundle durante o build.
#
# Em produção é SEMPRE `/api` — o mesmo domínio do app, com o nginx fazendo o
# proxy. Deixar em branco é o erro mais caro deste arquivo: o bundle assume
# `http://localhost:8002` e cada celular passa a chamar o próprio localhost,
# o que derruba o app inteiro sem uma única mensagem de erro no servidor.
#
# Em desenvolvimento não vale nada: o `client.js` monta o endereço sozinho.
VITE_API_URL=/api

# ── Produção ───────────────────────────────────────────────────────────
# Só é lido pelo docker-compose.prod.yml. Ver a seção "Deploy" do README.
#
# Em produção o `FRONTEND_URL` lá em cima deixa de ser detalhe: ele é a única
# origem que o CORS do `main.py` aceita quando API_ENV=production. Precisa ser
# o endereço exato pelo qual o navegador abre o app — `https://` e sem barra no
# fim. Ex.: https://estoque.maisvida.cloud

# Domínio pelo qual o app é acessado. O Caddy emite e renova o certificado
# TLS deste nome sozinho. HTTPS não é enfeite aqui: sem ele o service worker
# não registra e o promotor perde o modo offline dentro do mercado.
APP_DOMAIN=estoque.suaempresa.com.br

# Vazio = certificado público via Let's Encrypt (exige o domínio acima
#          resolvendo para este servidor na internet).
# `tls internal` = certificado de uma CA do próprio Caddy, para rede interna
#          sem domínio público. Exige instalar a CA raiz em cada celular.
CADDY_TLS=

# Stage 1: build do frontend
FROM node:20-alpine AS builder
WORKDIR /app
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
COPY package.json package-lock.json ./
# `npm ci` e não `npm install`: instala exatamente o que está no lock. Com
# `install`, cada build no servidor podia resolver versões novas dentro dos
# `^` do package.json — o build que passou aqui não seria o mesmo que vai
# para o campo.
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

# Stage 2: servir via nginx
FROM nginx:1.25-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
